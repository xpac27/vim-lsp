scriptencoding utf-8

Describe lsp#internal#completion#ranking#rank
    Before each
        let saved_ignorecase = g:lsp_ignorecase
        new
        setlocal iskeyword=@,48-57,_,192-255
        call setline(1, [''])
    End

    After each
        let g:lsp_ignorecase = saved_ignorecase
        bwipe!
    End

    It ranks a full match ahead of a scattered match
        let items = [{'label': 'f_o_o'}, {'label': 'foo'}]
        let got = lsp#internal#completion#ranking#rank(items, {'base': 'foo'})
        Assert Equals(map(got, {_, item -> item.label}), ['foo', 'f_o_o'])
    End

    It ranks a case-correct prefix ahead of a weaker match
        let items = [{'label': 'foobar'}, {'label': 'FooBar'}]
        let got = lsp#internal#completion#ranking#rank(items, {'base': 'Fo'})
        Assert Equals(map(got, {_, item -> item.label}), ['FooBar', 'foobar'])
    End

    It uses camel-case and separator boundaries from matchfuzzypos
        if !exists('*matchfuzzypos')
            Skip Native fuzzy matching is unavailable
        endif
        let items = [{'label': 'foobar'}, {'label': 'FooBar'}, {'label': 'foo_bar'}]
        let got = lsp#internal#completion#ranking#rank(items, {'base': 'fb'})
        Assert Equals(map(got, {_, item -> item.label}), ['foo_bar', 'FooBar', 'foobar'])
    End

    It uses filterText instead of label
        let items = [
            \ {'label': 'first', 'filterText': 'zz'},
            \ {'label': 'second', 'filterText': 'foo'},
            \ ]
        let got = lsp#internal#completion#ranking#rank(items, {'base': 'foo'})
        Assert Equals(map(got, {_, item -> item.label}), ['second', 'first'])
    End

    It uses sortText after equal fuzzy scores
        let items = [
            \ {'label': 'fooTwo', 'sortText': 'b'},
            \ {'label': 'fooOne', 'sortText': 'a'},
            \ ]
        let got = lsp#internal#completion#ranking#rank(items, {'base': 'foo'})
        Assert Equals(map(got, {_, item -> item.label}), ['fooOne', 'fooTwo'])
    End

    It uses nearer occurrences after equal fuzzy and sortText
        call setline(1, ['nearby faraway', '', '', 'faraway', '', 'ne'])
        let items = [
            \ {'label': 'nearby', 'sortText': 'same'},
            \ {'label': 'faraway', 'sortText': 'same'},
            \ ]
        let context = {
            \ 'base': '',
            \ 'bufnr': bufnr('%'),
            \ 'position': {'line': 5, 'character': 2},
            \ 'start_character': 0,
            \ 'locality': v:true,
            \ }
        let got = lsp#internal#completion#ranking#rank(items, context)
        Assert Equals(map(got, {_, item -> item.label}), ['faraway', 'nearby'])
    End

    It gives keywords and snippets neutral locality
        call setline(1, ['nearby nearby', '', 'ne'])
        let items = [
            \ {'label': 'unseen', 'sortText': 'same', 'kind': 6},
            \ {'label': 'nearby', 'sortText': 'same', 'kind': 14},
            \ {'label': 'nearby', 'sortText': 'same', 'kind': 15},
            \ ]
        let context = {
            \ 'base': '',
            \ 'bufnr': bufnr('%'),
            \ 'position': {'line': 2, 'character': 2},
            \ 'start_character': 0,
            \ 'locality': v:true,
            \ }
        let got = lsp#internal#completion#ranking#rank(items, context)
        Assert Equals(map(got, {_, item -> get(item, 'kind', 0)}), [6, 14, 15])
    End

    It excludes the current incomplete word from locality
        call setline(1, ['local'])
        let items = [
            \ {'label': 'other', 'sortText': 'same'},
            \ {'label': 'local', 'sortText': 'same'},
            \ ]
        let context = {
            \ 'base': '',
            \ 'bufnr': bufnr('%'),
            \ 'position': {'line': 0, 'character': 5},
            \ 'start_character': 0,
            \ 'locality': v:true,
            \ }
        let got = lsp#internal#completion#ranking#rank(items, context)
        Assert Equals(map(got, {_, item -> item.label}), ['other', 'local'])
    End

    It allows locality to decide when all sortText values are missing
        call setline(1, ['nearby', '', 'x'])
        let items = [
            \ {'label': 'unseen'},
            \ {'label': 'nearby'},
            \ ]
        let context = {
            \ 'base': '',
            \ 'bufnr': bufnr('%'),
            \ 'position': {'line': 2, 'character': 1},
            \ 'start_character': 0,
            \ 'locality': v:true,
            \ }
        let got = lsp#internal#completion#ranking#rank(items, context)
        Assert Equals(map(got, {_, item -> item.label}), ['nearby', 'unseen'])
    End

    It uses shorter filter text as the fallback
        let items = [{'label': 'foobar'}, {'label': 'food'}]
        let got = lsp#internal#completion#ranking#rank(items, {'base': 'fo', 'fuzzy': v:false})
        Assert Equals(map(got, {_, item -> item.label}), ['food', 'foobar'])
    End

    It preserves original order for complete ties
        let items = [{'label': 'same', 'data': 1}, {'label': 'same', 'data': 2}]
        let got = lsp#internal#completion#ranking#rank(items, {'base': 'same'})
        Assert Equals(map(got, {_, item -> item.data}), [1, 2])
    End

    It preserves server order for an empty base without sortText or locality
        let items = [{'label': 'longer'}, {'label': 'x'}, {'label': 'same'}]
        let got = lsp#internal#completion#ranking#rank(items, {'base': ''})
        Assert Equals(got, items)
    End

    It handles multibyte labels and buffer text
        call setline(1, ['ångström', '', 'å'])
        let items = [
            \ {'label': 'unseen', 'sortText': 'same'},
            \ {'label': 'ångström', 'sortText': 'same'},
            \ ]
        let context = {
            \ 'base': '',
            \ 'bufnr': bufnr('%'),
            \ 'position': {'line': 2, 'character': 1},
            \ 'start_character': 0,
            \ 'locality': v:true,
            \ }
        let got = lsp#internal#completion#ranking#rank(items, context)
        Assert Equals(map(got, {_, item -> item.label}), ['ångström', 'unseen'])
    End

    It falls back neutrally for an unloaded buffer
        let items = [{'label': 'longer'}, {'label': 'x'}]
        let context = {
            \ 'base': '',
            \ 'bufnr': 999999,
            \ 'position': {'line': 0, 'character': 0},
            \ 'locality': v:true,
            \ }
        let got = lsp#internal#completion#ranking#rank(items, context)
        Assert Equals(got, items)
    End

    It preserves server order above max
        let items = [{'label': 'three'}, {'label': 'one'}, {'label': 'two'}]
        let got = lsp#internal#completion#ranking#rank(items, {'base': '', 'max': 2})
        Assert Equals(got, items)
    End

    It does not mutate the input list
        let items = [{'label': 'food', 'sortText': 'z'}, {'label': 'foo', 'sortText': 'a'}]
        let before = deepcopy(items)
        let got = lsp#internal#completion#ranking#rank(items, {'base': 'foo'})
        Assert Equals(map(got, {_, item -> item.label}), ['foo', 'food'])
        Assert Equals(items, before)
    End

    It has a deterministic non-fuzzy fallback
        let g:lsp_ignorecase = v:true
        let items = [
            \ {'label': 'unrelated'},
            \ {'label': 'Foobar'},
            \ {'label': 'foobar'},
            \ {'label': 'foo'},
            \ ]
        let got = lsp#internal#completion#ranking#rank(items, {'base': 'foo', 'fuzzy': v:false})
        Assert Equals(map(got, {_, item -> item.label}), ['foo', 'foobar', 'Foobar', 'unrelated'])
    End

    It ranks a negative fuzzy score ahead of a non-match
        if !exists('*matchfuzzypos')
            Skip Native fuzzy matching is unavailable
        endif
        let weak = {'label': 'x' . repeat('z', 200) . 'y'}
        let items = [{'label': 'unrelated'}, weak]
        let got = lsp#internal#completion#ranking#rank(items, {'base': 'xy'})
        Assert Equals(got[0], weak)
    End

    It has a consistent order for every permutation of mixed sortText values
        " The old pairwise missing-key rule formed a cycle: a < b < c < a.
        let a = {'label': 'aaa', 'sortText': 'z'}
        let b = {'label': 'bbbb'}
        let c = {'label': 'ccccc', 'sortText': 'a'}
        for items in [[a, b, c], [a, c, b], [b, a, c], [b, c, a], [c, a, b], [c, b, a]]
            let got = lsp#internal#completion#ranking#rank(items, {'base': ''})
            Assert Equals(got, [c, b, a])
        endfor
    End

    It compares opaque sortText keys case-sensitively regardless of ignorecase
        let g:lsp_ignorecase = v:true
        let items = [{'label': 'one', 'sortText': 'a'}, {'label': 'two', 'sortText': 'Z'}]
        let got = lsp#internal#completion#ranking#rank(items, {'base': ''})
        Assert Equals(map(got, {_, item -> item.label}), ['two', 'one'])
    End

    It uses each text edit start instead of the earliest start in the list
        let member = {'label': 'foo', 'textEdit': {
            \ 'range': {'start': {'line': 0, 'character': 4}, 'end': {'line': 0, 'character': 6}},
            \ 'newText': 'foo',
            \ }}
        let other = {'label': 'a', 'textEdit': {
            \ 'range': {'start': {'line': 0, 'character': 0}, 'end': {'line': 0, 'character': 6}},
            \ 'newText': 'a',
            \ }}
        let got = lsp#internal#completion#ranking#rank([other, member], {
            \ 'base': 'fo', 'line': 'obj.fo', 'position': {'line': 0, 'character': 6},
            \ })
        Assert Equals(got, [member, other])
    End

    It uses the default base for null text edits
        let items = [{'label': 'a', 'textEdit': v:null}, {'label': 'foo', 'textEdit': v:null}]
        let got = lsp#internal#completion#ranking#rank(items, {
            \ 'base': 'fo', 'line': 'obj.fo', 'position': {'line': 0, 'character': 6},
            \ })
        Assert Equals(map(got, {_, item -> item.label}), ['foo', 'a'])
    End

    It respects the buffer keyword definition when collecting locality
        setlocal iskeyword+=-
        call setline(1, ['foo-bar', '', 'f'])
        let items = [{'label': 'foo'}, {'label': 'foo-bar'}]
        let got = lsp#internal#completion#ranking#rank(items, {
            \ 'base': '', 'bufnr': bufnr('%'), 'locality': v:true,
            \ 'position': {'line': 2, 'character': 1}, 'start_character': 0,
            \ })
        Assert Equals(map(got, {_, item -> item.label}), ['foo-bar', 'foo'])
    End

    It excludes the incomplete word after multibyte text from locality
        call setline(1, ['é local'])
        let items = [{'label': 'other'}, {'label': 'local'}]
        let got = lsp#internal#completion#ranking#rank(items, {
            \ 'base': '', 'bufnr': bufnr('%'), 'locality': v:true,
            \ 'position': {'line': 0, 'character': 7}, 'start_character': 2,
            \ })
        Assert Equals(got, items)
    End

    It bounds locality near the beginning and end of a large buffer
        call setline(1, repeat([''], 5000))
        call setline(2500, 'out_of_range')
        let items = [{'label': 'unseen'}, {'label': 'out_of_range'}]
        for cursor_line in [0, 4999]
            let got = lsp#internal#completion#ranking#rank(items, {
                \ 'base': '', 'bufnr': bufnr('%'), 'locality': v:true,
                \ 'position': {'line': cursor_line, 'character': 0},
                \ })
            Assert Equals(got, items)
        endfor
    End
End
