scriptencoding utf-8

Describe lsp#omni

    let g:lsp_get_vim_completion_item_set_kind = 1

    Before each
        new
        let saved_ignorecase = g:lsp_ignorecase
        call lsp#omni#_clear_managed_user_data_map()
    End

    After each
        let g:lsp_ignorecase = saved_ignorecase
        bwipe!
    End

    Describe lsp#omni#get_vim_completion_items
        It should return item with proper kind
            let item = {
            \ 'label': 'my-label',
            \ 'documentation': 'my documentation.',
            \ 'detail': 'my-detail',
            \ 'kind': '3'
            \}

            let options = {
            \ 'server': { 'name': 'dummy-server' },
            \ 'position': lsp#get_position(),
            \ 'response': { 'result': [item] },
            \}

            let want = {
            \ 'items': [{
            \   'word': 'my-label',
            \   'abbr': 'my-label',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"0"}',
            \ }],
            \ 'incomplete': 0,
            \ 'startcol': lsp#utils#position#lsp_character_to_vim('%', lsp#get_position()),
            \}

            Assert Equals(lsp#omni#get_vim_completion_items(options), want)
        End

        It should get user_data by the item
            if !has('patch-8.0.1493')
                Skip This test requires 'patch-8.0.1493'
            endif

            let item = {
            \ 'label': 'my-label',
            \ 'documentation': 'my documentation.',
            \ 'detail': 'my-detail',
            \ 'kind': '3',
            \ 'textEdit': {
            \    'range': {
            \      'start': {'line': 5, 'character': 0},
            \      'end': {'line': 5, 'character': 5}
            \    },
            \    'newText': 'yyy'
            \  }
            \}

            let options = {
            \ 'server': { 'name': 'dummy-server' },
            \ 'position': { 'line': 1, 'character': 1 },
            \ 'response': { 'result': [item] },
            \}

            let want = {
            \ 'items': [{
            \  'word': 'yyy',
            \  'abbr': 'my-label',
            \  'icase': 1,
            \  'dup': 1,
            \  'empty': 1,
            \  'kind': 'function',
            \  'user_data': '{"vim-lsp/key":"0"}',
            \  }],
            \  'incomplete': 0,
            \  'startcol': lsp#utils#position#lsp_character_to_vim('%', {'line': 1, 'character': 0}),
            \}

            let got = lsp#omni#get_vim_completion_items(options)
            Assert Equals(got, want)
            Assert Equals(lsp#omni#get_managed_user_data_from_completed_item(got['items'][0]), {
                        \   'server_name': 'dummy-server',
                        \   'completion_item': item,
                        \   'complete_position': { 'line': 1, 'character': 1 },
                        \   'start_character': 0,
                        \   'complete_word': 'yyy',
                        \ })
        End

        It should not raise errors
            let item = {
            \ 'label': 'my-label',
            \ 'textEdit': v:null,
            \}

            let options = {
            \ 'server': { 'name': 'dummy-server' },
            \ 'position': lsp#get_position(),
            \ 'response': { 'result': [item] },
            \}

            let want = {
            \ 'items': [{
            \  'word': 'my-label',
            \  'abbr': 'my-label',
            \  'icase': 1,
            \  'dup': 1,
            \  'empty': 1,
            \  'kind': '',
            \  'user_data': '{"vim-lsp/key":"0"}',
            \  }],
            \  'incomplete': 0,
            \  'startcol': lsp#utils#position#lsp_character_to_vim('%', lsp#get_position()),
            \}

            let got = lsp#omni#get_vim_completion_items(options)
            Assert Equals(got, want)

            let item = {
            \ 'label': 'my-label',
            \ 'textEdit': v:null,
            \ 'insertText': v:null,
            \}

            let options = {
            \ 'server': { 'name': 'dummy-server' },
            \ 'position': lsp#get_position(),
            \ 'response': { 'result': [item] },
            \}

            let want = {
            \ 'items': [{
            \  'word': 'my-label',
            \  'abbr': 'my-label',
            \  'icase': 1,
            \  'dup': 1,
            \  'empty': 1,
            \  'kind': '',
            \  'user_data': '{"vim-lsp/key":"1"}',
            \  }],
            \  'incomplete': 0,
            \  'startcol': lsp#utils#position#lsp_character_to_vim('%', lsp#get_position()),
            \}

            let got = lsp#omni#get_vim_completion_items(options)
            Assert Equals(got, want)
        End

        It should return correct items for snippets
            if !has('patch-8.0.1493')
                Skip This test requires 'patch-8.0.1493'
            endif

            let item = {
                \ "label": "sysout",
                \ "insertText": "System.out.println(${0});",
                \ "kind": 15,
                \ "insertTextFormat": 2,
                \ "documentation": "System.out.println();",
                \ "detail": "print to standard out"
                \ }

            let options = {
            \ 'server': { 'name': 'dummy-server' },
            \ 'position': { 'line': 1, 'character': 1 },
            \ 'response': { 'result': [item] },
            \}

            let want = {
            \ 'items': [{
            \  'word': 'System.out.println',
            \  'abbr': 'sysout~',
            \  'icase': 1,
            \  'dup': 1,
            \  'empty': 1,
            \  'kind': 'snippet',
            \  'user_data': '{"vim-lsp/key":"0"}',
            \  }],
            \  'incomplete': 0,
            \  'startcol': lsp#utils#position#lsp_character_to_vim('%', { 'line': 1, 'character': 1 }),
            \}

            let got = lsp#omni#get_vim_completion_items(options)
            Assert Equals(got, want)
            Assert Equals(lsp#omni#get_managed_user_data_from_completed_item(got['items'][0]), {
                        \   'server_name': 'dummy-server',
                        \   'completion_item': item,
                        \   'complete_position': { 'line': 1, 'character': 1 },
                        \   'start_character': 0,
                        \   'complete_word': 'System.out.println(${0});',
                        \ })
        End

        It should sort by sortText
            let items = [{
            \ 'label': 'my-label1',
            \ 'kind': '3',
            \ 'sortText': 'c'
            \},
            \{
            \ 'label': 'my-label2',
            \ 'kind': '3',
            \ 'sortText': 'a'
            \},
            \{
            \ 'label': 'my-label3',
            \ 'kind': '3',
            \ 'sortText': 'b'
            \}]

            let options = {
            \ 'server': {
            \   'name': 'dummy-server',
            \   'config': {
            \     'sort': { 'max': 100 },
            \   },
            \  },
            \ 'position': lsp#get_position(),
            \ 'response': { 'result': items },
            \}

            let want = {
            \ 'items': [{
            \   'word': 'my-label2',
            \   'abbr': 'my-label2',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"0"}',
            \ },
            \ {
            \   'word': 'my-label3',
            \   'abbr': 'my-label3',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"1"}',
            \ },
            \ {
            \   'word': 'my-label1',
            \   'abbr': 'my-label1',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"2"}',
            \ }],
            \ 'incomplete': 0,
            \ 'startcol': lsp#utils#position#lsp_character_to_vim('%', lsp#get_position()),
            \}

            Assert Equals(lsp#omni#get_vim_completion_items(options), want)
        End

        It should not sort over max
            let items = [{
            \ 'label': 'my-label3',
            \ 'kind': '3',
            \ 'sortText': '3'
            \},
            \{
            \ 'label': 'my-label1',
            \ 'kind': '3',
            \ 'sortText': '1'
            \},
            \{
            \ 'label': 'my-label2',
            \ 'kind': '3',
            \ 'sortText': '2'
            \}]

            let options = {
            \ 'server': {
            \   'name': 'dummy-server',
            \   'config': {
            \     'sort': { 'max': 2 },
            \   },
            \  },
            \ 'position': lsp#get_position(),
            \ 'response': { 'result': items },
            \}

            let want = {
            \ 'items': [{
            \   'word': 'my-label3',
            \   'abbr': 'my-label3',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"0"}',
            \ },
            \ {
            \   'word': 'my-label1',
            \   'abbr': 'my-label1',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"1"}',
            \ },
            \ {
            \   'word': 'my-label2',
            \   'abbr': 'my-label2',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"2"}',
            \ }],
            \ 'incomplete': 0,
            \ 'startcol': lsp#utils#position#lsp_character_to_vim('%', lsp#get_position()),
            \}
            Assert Equals(lsp#omni#get_vim_completion_items(options), want)
        End

        It should sort by label(sortText not exists)
            let items = [{
            \ 'label': 'my-label3',
            \ 'kind': '3',
            \},
            \{
            \ 'label': 'my-label1',
            \ 'kind': '3',
            \},
            \{
            \ 'label': 'my-label2',
            \ 'kind': '3',
            \}]

            let options = {
            \ 'server': {
            \   'name': 'dummy-server',
            \   'config': {
            \     'sort': { 'max': 10 },
            \   },
            \  },
            \ 'position': lsp#get_position(),
            \ 'response': { 'result': items },
            \}

            let want = {
            \ 'items': [{
            \   'word': 'my-label1',
            \   'abbr': 'my-label1',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"0"}',
            \ },
            \ {
            \   'word': 'my-label2',
            \   'abbr': 'my-label2',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"1"}',
            \ },
            \ {
            \   'word': 'my-label3',
            \   'abbr': 'my-label3',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"2"}',
            \ }],
            \ 'incomplete': 0,
            \ 'startcol': lsp#utils#position#lsp_character_to_vim('%', lsp#get_position()),
            \}
            Assert Equals(lsp#omni#get_vim_completion_items(options), want)
        End

        It should sort by label(empty sortText)
            let items = [{
            \ 'label': 'my-label3',
            \ 'kind': '3',
            \ 'sortText': ''
            \},
            \{
            \ 'label': 'my-label1',
            \ 'kind': '3',
            \ 'sortText': '',
            \},
            \{
            \ 'label': 'my-label2',
            \ 'kind': '3',
            \ 'sortText': '',
            \}]

            let options = {
            \ 'server': {
            \   'name': 'dummy-server',
            \   'config': {
            \     'sort': { 'max': 10 },
            \   },
            \  },
            \ 'position': lsp#get_position(),
            \ 'response': { 'result': items },
            \}

            let want = {
            \ 'items': [{
            \   'word': 'my-label1',
            \   'abbr': 'my-label1',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"0"}',
            \ },
            \ {
            \   'word': 'my-label2',
            \   'abbr': 'my-label2',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"1"}',
            \ },
            \ {
            \   'word': 'my-label3',
            \   'abbr': 'my-label3',
            \   'icase': 1,
            \   'dup': 1,
            \   'empty': 1,
            \   'kind': 'function',
            \   'user_data': '{"vim-lsp/key":"2"}',
            \ }],
            \ 'incomplete': 0,
            \ 'startcol': lsp#utils#position#lsp_character_to_vim('%', lsp#get_position()),
            \}
            Assert Equals(lsp#omni#get_vim_completion_items(options), want)
        End

        It should support the explicit sortText sort name
            let items = [
            \ {'label': 'second', 'sortText': 'b'},
            \ {'label': 'first', 'sortText': 'a'},
            \ ]
            let options = {
            \ 'server': {
            \   'name': 'dummy-server',
            \   'config': {'sort': {'name': 'sortText', 'max': 10}},
            \ },
            \ 'position': lsp#get_position(),
            \ 'response': {'result': items},
            \ }

            let got = lsp#omni#get_vim_completion_items(options)
            Assert Equals(map(got.items, {_, item -> item.word}), ['first', 'second'])
        End

        It should rank list responses by relevance
            call setline(1, 'fo')
            let items = [
            \ {'label': 'f_o_o'},
            \ {'label': 'foo'},
            \ ]
            let options = {
            \ 'server': {
            \   'name': 'dummy-server',
            \   'config': {'sort': {'name': 'relevance', 'max': 10}},
            \ },
            \ 'position': {'line': 0, 'character': 2},
            \ 'response': {'result': items},
            \ }

            let got = lsp#omni#get_vim_completion_items(options)
            Assert Equals(map(got.items, {_, item -> item.word}), ['foo', 'f_o_o'])
            Assert Equals(got.incomplete, 0)
        End

        It should rank CompletionList responses and preserve isIncomplete
            call setline(1, 'fo')
            let items = [
            \ {'label': 'f_o_o'},
            \ {'label': 'foo'},
            \ ]
            let options = {
            \ 'server': {
            \   'name': 'dummy-server',
            \   'config': {'sort': {'name': 'relevance', 'max': 10}},
            \ },
            \ 'position': {'line': 0, 'character': 2},
            \ 'response': {
            \   'result': {'items': items, 'isIncomplete': v:true},
            \ },
            \ }

            let got = lsp#omni#get_vim_completion_items(options)
            Assert Equals(map(got.items, {_, item -> item.word}), ['foo', 'f_o_o'])
            Assert Equals(got.incomplete, v:true)
        End

        It should keep managed user_data aligned after relevance ranking
            if !has('patch-8.0.1493')
                Skip This test requires 'patch-8.0.1493'
            endif

            call setline(1, 'fo')
            let weak = {'label': 'f_o_o', 'data': 'weak'}
            let strong = {'label': 'foo', 'data': 'strong'}
            let options = {
            \ 'server': {
            \   'name': 'dummy-server',
            \   'config': {'sort': {'name': 'relevance', 'max': 10}},
            \ },
            \ 'position': {'line': 0, 'character': 2},
            \ 'response': {'result': [weak, strong]},
            \ }

            let got = lsp#omni#get_vim_completion_items(options)
            let managed = lsp#omni#get_managed_user_data_from_completed_item(got.items[0])
            Assert Equals(managed.completion_item, strong)
            Assert Equals(managed.complete_word, 'foo')
        End

        It should preserve snippet and text-edit correction after ranking
            if !has('patch-8.0.1493')
                Skip This test requires 'patch-8.0.1493'
            endif

            call setline(1, 'obj.fo')
            let weak = {
            \ 'label': 'weak',
            \ 'filterText': 'zz',
            \ 'textEdit': {
            \   'range': {
            \     'start': {'line': 0, 'character': 2},
            \     'end': {'line': 0, 'character': 6},
            \   },
            \   'newText': 'weak',
            \ },
            \ }
            let strong = {
            \ 'label': 'foo',
            \ 'filterText': 'foo',
            \ 'insertTextFormat': 2,
            \ 'textEdit': {
            \   'range': {
            \     'start': {'line': 0, 'character': 4},
            \     'end': {'line': 0, 'character': 6},
            \   },
            \   'newText': 'foo(${1:value})',
            \ },
            \ }
            let options = {
            \ 'server': {
            \   'name': 'dummy-server',
            \   'config': {'sort': {'name': 'relevance', 'max': 10}},
            \ },
            \ 'position': {'line': 0, 'character': 6},
            \ 'response': {'result': [weak, strong]},
            \ }

            let got = lsp#omni#get_vim_completion_items(options)
            Assert Equals(map(copy(got.items), {_, item -> item.word}), ['j.foo', 'weak'])
            Assert Equals(got.startcol, 3)
            let managed = lsp#omni#get_managed_user_data_from_completed_item(got.items[0])
            Assert Equals(managed.completion_item, strong)
            Assert Equals(managed.start_character, 4)
            Assert Equals(managed.complete_word, 'foo(${1:value})')
        End

        It should not mutate list or CompletionList responses while sorting
            for config in [
                \ {'sort': {'max': 10}},
                \ {'sort': {'name': 'relevance', 'max': 10}},
                \ ]
                let items = [
                \ {'label': 'second', 'sortText': 'b'},
                \ {'label': 'first', 'sortText': 'a'},
                \ ]
                let list_response = {'result': items}
                let completion_list_response = {
                \ 'result': {'items': items, 'isIncomplete': v:false},
                \ }
                let before_list = deepcopy(list_response)
                let before_completion_list = deepcopy(completion_list_response)
                let server = {'name': 'dummy-server', 'config': config}

                call lsp#omni#get_vim_completion_items({
                \ 'server': server,
                \ 'position': lsp#get_position(),
                \ 'response': list_response,
                \ })
                call lsp#omni#get_vim_completion_items({
                \ 'server': server,
                \ 'position': lsp#get_position(),
                \ 'response': completion_list_response,
                \ })

                Assert Equals(list_response, before_list)
                Assert Equals(completion_list_response, before_completion_list)
            endfor
        End

        Describe g:lsp_ignorecase
            Before all
                let saved_ignorecase = get(g:, 'lsp_ignorecase', v:null)
            End

            After all
                if saved_ignorecase isnot v:null
                    let g:lsp_ignorecase = saved_ignorecase
                endif
            End

            It should sort completion items case-insensitive when true is set
                let g:lsp_ignorecase = v:true

                " 'B' < 'a' but 'a' < 'b'
                let result = [{
                \ 'label': 'my-label1',
                \ 'kind': '3',
                \ 'sortText': 'B'
                \},
                \{
                \ 'label': 'my-label2',
                \ 'kind': '3',
                \ 'sortText': 'a'
                \}]

                let options = {
                \ 'server': {
                \   'name': 'dummy-server',
                \   'config': {
                \     'sort': { 'max': 10 },
                \   },
                \ },
                \ 'position': lsp#get_position(),
                \ 'response': { 'result': result },
                \}

                let want = [{
                \  'word': 'my-label2',
                \  'abbr': 'my-label2',
                \  'icase': 1,
                \  'dup': 1,
                \  'empty': 1,
                \  'kind': 'function',
                \  'user_data': '{"vim-lsp/key":"0"}',
                \},
                \{
                \  'word': 'my-label1',
                \  'abbr': 'my-label1',
                \  'icase': 1,
                \  'dup': 1,
                \  'empty': 1,
                \  'kind': 'function',
                \  'user_data': '{"vim-lsp/key":"1"}',
                \}]

                Assert Equals(lsp#omni#get_vim_completion_items(options).items, want)
            End
        End
    End

    Describe lsp#omni#_filter_completion_items
        It should fuzzy filter and score matches
            if !exists('*matchfuzzypos')
                Skip Native fuzzy matching is unavailable
            endif
            let items = [
            \ {'word': 'f_o_o'},
            \ {'word': 'foo'},
            \ {'word': 'bar'},
            \ ]

            let got = lsp#omni#_filter_completion_items(items, 'foo', 'fuzzy')
            Assert Equals(map(got, {_, item -> item.word}), ['foo', 'f_o_o'])
        End

        It should fuzzy filter with LSP filterText
            let raw_items = [
            \ {'label': 'unrelated', 'filterText': 'foo'},
            \ {'label': 'bar'},
            \ ]
            let converted = lsp#omni#get_vim_completion_items({
            \ 'server': {'name': 'dummy-server'},
            \ 'position': lsp#get_position(),
            \ 'response': {'result': raw_items},
            \ }).items

            let got = lsp#omni#_filter_completion_items(converted, 'foo', 'fuzzy')
            Assert Equals(map(got, {_, item -> item.word}), ['unrelated'])
        End

        It should fall back to prefix filtering when fuzzy matching is disabled
            let items = [
            \ {'word': 'f_o_o'},
            \ {'word': 'foo'},
            \ ]

            let got = lsp#omni#_filter_completion_items(items, 'fo', 'fuzzy', {'fuzzy': v:false})
            Assert Equals(map(got, {_, item -> item.word}), ['foo'])
        End

        It should preserve incoming order for equal fuzzy scores
            let raw_items = [
            \ {'label': 'zeta', 'filterText': 'foo'},
            \ {'label': 'alpha', 'filterText': 'foo'},
            \ ]
            let converted = lsp#omni#get_vim_completion_items({
            \ 'server': {'name': 'dummy-server'},
            \ 'position': lsp#get_position(),
            \ 'response': {'result': raw_items},
            \ }).items

            let got = lsp#omni#_filter_completion_items(converted, 'foo', 'fuzzy')
            Assert Equals(map(got, {_, item -> item.word}), ['zeta', 'alpha'])
        End

        It matches snippet labels rather than their expansion text
            let converted = lsp#omni#get_vim_completion_items({
                \ 'server': {'name': 'dummy-server'},
                \ 'position': lsp#get_position(),
                \ 'response': {'result': [
                \     {'label': 'sysout', 'insertText': 'System.out.println(${0});', 'insertTextFormat': 2},
                \     {'label': 'unrelated'},
                \ ]},
                \ }).items
            for options in [{}, {'fuzzy': v:false}]
                let got = lsp#omni#_filter_completion_items(converted, 'sysout', 'fuzzy', options)
                Assert Equals(map(got, {_, item -> item.abbr}), ['sysout~'])
            endfor
        End

        It treats whitespace as an ordered part of the query
            let items = [{'word': 'bar foo'}, {'word': 'foo bar'}]
            let got = lsp#omni#_filter_completion_items(items, 'foo bar', 'fuzzy')
            Assert Equals(map(got, {_, item -> item.word}), ['foo bar'])
        End

        It preserves a supplied ranking while removing non-matches
            let items = [{'word': 'f_o_o'}, {'word': 'bar'}, {'word': 'foo'}]
            let before = deepcopy(items)
            let got = lsp#omni#_filter_completion_items(items, 'foo', 'fuzzy', {'preserve_order': v:true})
            if exists('*matchfuzzypos')
                Assert Equals(map(got, {_, item -> item.word}), ['f_o_o', 'foo'])
            else
                Assert Equals(map(got, {_, item -> item.word}), ['foo'])
            endif
            Assert Equals(items, before)
        End

        It preserves server order through filtering when relevance exceeds max
            call setline(1, 'fo')
            let converted = lsp#omni#get_vim_completion_items({
                \ 'server': {'name': 'dummy-server', 'config': {'sort': {'name': 'relevance', 'max': 1}}},
                \ 'position': {'line': 0, 'character': 2},
                \ 'response': {'result': [{'label': 'foobar'}, {'label': 'foo'}]},
                \ }).items
            let got = lsp#omni#_filter_completion_items(converted, 'fo', 'fuzzy', {'preserve_order': v:true})
            Assert Equals(map(got, {_, item -> item.word}), ['foobar', 'foo'])
        End

        It ranks and filters items with different edit starts after multibyte text
            call setline(1, 'é.fo')
            let member = {'label': 'foo', 'textEdit': {
                \ 'range': {'start': {'line': 0, 'character': 2}, 'end': {'line': 0, 'character': 4}},
                \ 'newText': 'foo',
                \ }}
            let other = {'label': 'a', 'textEdit': {
                \ 'range': {'start': {'line': 0, 'character': 0}, 'end': {'line': 0, 'character': 4}},
                \ 'newText': 'a',
                \ }}
            let converted = lsp#omni#get_vim_completion_items({
                \ 'server': {'name': 'dummy-server', 'config': {'sort': {'name': 'relevance'}}},
                \ 'position': {'line': 0, 'character': 4},
                \ 'response': {'result': [other, member]},
                \ })
            Assert Equals(map(copy(converted.items), {_, item -> item.word}), ['é.foo', 'a'])
            Assert Equals(converted.startcol, 1)
            let got = lsp#omni#_filter_completion_items(converted.items, 'é.fo', 'fuzzy', {
                \ 'preserve_order': v:true, 'start_character': 0,
                \ })
            Assert Equals(map(copy(got), {_, item -> item.word}), ['é.foo'])
            Assert Equals(lsp#omni#get_managed_user_data_from_completed_item(got[0]).completion_item, member)
        End

        It respects ignorecase in the non-native fallback
            let items = [{'word': 'Foo'}, {'word': 'foo'}]
            let g:lsp_ignorecase = v:false
            let got = lsp#omni#_filter_completion_items(items, 'fo', 'fuzzy', {'fuzzy': v:false})
            Assert Equals(map(got, {_, item -> item.word}), ['foo'])
            let g:lsp_ignorecase = v:true
            let got = lsp#omni#_filter_completion_items(items, 'fo', 'fuzzy', {'fuzzy': v:false})
            Assert Equals(got, items)
        End

        It uses native fuzzy case matching independently of ignorecase
            if !exists('*matchfuzzypos')
                Skip Native fuzzy matching is unavailable
            endif
            let g:lsp_ignorecase = v:false
            let items = [{'word': 'foobar'}, {'word': 'FooBar'}]
            let got = lsp#omni#_filter_completion_items(items, 'fo', 'fuzzy')
            Assert Equals(sort(map(got, {_, item -> item.word})), ['FooBar', 'foobar'])
        End

        It retains the legacy prefix contains and unknown filters
            let g:lsp_ignorecase = v:false
            let items = [{'word': 'barfoo'}, {'word': 'foo'}, {'word': 'Foo'}]
            let before = deepcopy(items)
            Assert Equals(lsp#omni#_filter_completion_items(items, 'fo', 'prefix'), [items[1]])
            Assert Equals(lsp#omni#_filter_completion_items(items, 'fo', 'contains'), items[:1])
            Assert Equals(lsp#omni#_filter_completion_items(items, 'fo', 'unknown'), items)
            Assert Equals(items, before)
        End

        It preserves all candidates for an empty query
            let items = [{'word': 'longer'}, {'word': 'x'}]
            Assert Equals(lsp#omni#_filter_completion_items(items, '', 'fuzzy'), items)
            Assert Equals(lsp#omni#_filter_completion_items([], 'fo', 'fuzzy'), [])
        End
    End
End
